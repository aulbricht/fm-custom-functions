/**
 *
 * Unformats a JSON object
 *
 * @param {text} json - JSON object
 *
 * @returnSuccess {object} returns unformatted JSON object
 * 
 * @module JSON
 * 
 * @version 1.1.0
 * @author Allen Ulbricht, https://github.com/aulbricht
 *
 */


Let ([

	~json = json;
	~validate = JSONFormatElements ( ~json );

~=""];

If ( Left ( ~validate; 1 ) ≠ "?" ; 
	JSONDeleteElement ( json ; Get ( UUID ) ) ; 
	~json 
	)

)